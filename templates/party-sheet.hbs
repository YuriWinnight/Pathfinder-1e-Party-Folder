<form class="pf1-party-sheet-root {{party.portraitClass}} {{party.themeClass}}" autocomplete="off">
  <header class="pf1-party-hero">
    <div class="pf1-party-token-wrap">
      <div class="pf1-party-token-drag" draggable="true" title="Перетащить токен партии на сцену">
        <img class="profile-img" src="{{party.tokenImg}}" alt="The Party" draggable="false">
      </div>
      <button type="button" class="pf1-party-img-edit" data-action="edit-party-img" title="Сменить картинку партии"><i class="fas fa-image"></i></button>
    </div>
    <div class="pf1-party-title-block">
      <input type="text" class="pf1-party-name-input" value="{{party.name}}" title="Переименовать партию">
    </div>
    <div class="pf1-party-right-title">
      <div>ПАРТИЯ</div>
      {{#if party.canConfigureMetagame}}
      <span class="pf1-metagame-open" data-action="metagame-settings" title="Метаигровая информация"><i class="fas fa-cog"></i> {{party.permissionLabel}}</span>
      {{/if}}
      <small class="pf1-party-version">{{party.moduleVersion}}</small>
    </div>
  </header>

  <nav class="pf1-party-primary-tabs tabs" data-group="primary">
    <a class="item active" data-tab="overview">Обзор</a>
    <a class="item" data-tab="statistics">Статистика</a>
    <a class="item" data-tab="stash">Тайник</a>
  </nav>

  <main class="pf1-party-body">
    <section class="tab active" data-group="primary" data-tab="overview">
      <div class="pf1-party-panel pf1-party-overview-box">
        <nav class="pf1-party-overview-tabs tabs" data-group="overview">
          <a class="item active" data-tab="languages">Языки партии</a>
          <a class="item" data-tab="skills">Навыки партии</a>
          <a class="item" data-tab="knowledge">Вспомнить информацию</a>
          <a class="item" data-tab="quick-rolls">Быстрые броски</a>
        </nav>

        <section class="pf1-overview-content">
          <div class="tab active" data-group="overview" data-tab="languages">
            {{#if languages.length}}
              <div class="pf1-chip-list">
                {{#each languages}}
                  <span class="pf1-chip pf1-language-chip" {{#if tooltip}}data-tooltip="{{tooltipHtml}}"{{/if}}>{{label}}</span>
                {{/each}}
              </div>
            {{else}}
              <div class="pf1-empty">Нет</div>
            {{/if}}
          </div>

          <div class="tab" data-group="overview" data-tab="skills">
            {{#if skillGroups.length}}
              <div class="pf1-skill-groups">
                {{#each skillGroups}}
                  <section class="pf1-skill-group pf1-skill-group-{{id}}">
                    <h4>{{label}}</h4>
                    <div class="pf1-chip-list pf1-skill-list">
                      {{#each items}}
                        <button type="button" class="pf1-chip pf1-skill-chip {{toneClass}} {{#if invested}}is-invested{{/if}}" data-action="roll-skill" data-skill-id="{{id}}" data-skill-label="{{label}}" data-tooltip="{{tooltipHtml}}">
                          <span class="pf1-skill-main"><span class="pf1-skill-label">{{label}}</span><strong class="pf1-skill-bonus">{{signed best}}</strong></span>
                          <span class="pf1-skill-best">Лучший: {{bestActorName}}</span>
                        </button>
                      {{/each}}
                    </div>
                  </section>
                {{/each}}
              </div>
            {{else}}
              <div class="pf1-empty">Нет доступных навыков</div>
            {{/if}}
          </div>

          <div class="tab" data-group="overview" data-tab="knowledge">
            {{#if knowledgeGroups.length}}
              <div class="pf1-skill-groups">
                {{#each knowledgeGroups}}
                  <section class="pf1-skill-group pf1-skill-group-{{id}}">
                    <h4>{{label}}</h4>
                    <div class="pf1-chip-list pf1-skill-list">
                      {{#each items}}
                        <button type="button" class="pf1-chip pf1-skill-chip {{toneClass}} {{#if invested}}is-invested{{/if}}" data-action="roll-skill" data-skill-id="{{id}}" data-skill-label="{{label}}" data-tooltip="{{tooltipHtml}}">
                          <span class="pf1-skill-main"><span class="pf1-skill-label">{{label}}</span><strong class="pf1-skill-bonus">{{signed best}}</strong></span>
                          <span class="pf1-skill-best">Лучший: {{bestActorName}}</span>
                        </button>
                      {{/each}}
                    </div>
                  </section>
                {{/each}}
              </div>
            {{else}}
              <div class="pf1-empty">У партии нет навыков знаний</div>
            {{/if}}
          </div>

          <div class="tab" data-group="overview" data-tab="quick-rolls">
            <div class="pf1-quick-roll-groups">
              <div class="pf1-quick-roll-mode" role="group" aria-label="Видимость быстрых бросков">
                <button type="button" class="{{#if quickRollPublic}}is-active{{/if}}" data-action="set-quick-roll-mode" data-roll-mode="publicroll" aria-pressed="{{#if quickRollPublic}}true{{else}}false{{/if}}" title="Броски и сводка видны всем">
                  <i class="fas fa-eye"></i><span>Публично</span>
                </button>
                <button type="button" class="{{#if quickRollHidden}}is-active{{/if}}" data-action="set-quick-roll-mode" data-roll-mode="blindroll" aria-pressed="{{#if quickRollHidden}}true{{else}}false{{/if}}" title="Броски и сводка видны только игровому мастеру">
                  <i class="fas fa-user-secret"></i><span>Только игровому мастеру</span>
                </button>
              </div>
              {{#each quickRollGroups}}
                <section class="pf1-quick-roll-group">
                  <h4>{{label}}</h4>
                  <div class="pf1-quick-roll-buttons">
                    {{#each items}}
                      <button type="button" data-action="quick-party-roll" data-kind="{{../kind}}" data-check-id="{{id}}" title="Бросить за каждого персонажа партии">
                        <i class="{{icon}}"></i><span>{{label}}</span>
                      </button>
                    {{/each}}
                  </div>
                </section>
              {{/each}}
            </div>
          </div>
        </section>
      </div>

      <div class="pf1-party-member-list">
        {{#each members}}
          <article class="pf1-party-member-row">
            <div class="pf1-party-member-portrait">
              <img src="{{img}}" alt="{{name}}">
              <div class="pf1-party-hp" style="--pf1-hp-width: {{hp.width}};"><i class="fas fa-heart"></i> {{hp.value}} / {{hp.max}}</div>
            </div>
            <div class="pf1-party-member-main">
              <div class="pf1-party-member-header">
                <div class="pf1-party-member-name">{{name}} <span class="pf1-remove-member" data-action="remove-member" data-actor-id="{{id}}" title="Убрать из партии">×</span></div>
                {{#if heroPoints.enabled}}
                  <a class="pf1-hero-points" data-action="adjust-hero-points" data-actor-id="{{id}}" title="Геройские очки: {{heroPoints.value}} / {{heroPoints.max}}. ЛКМ +1, ПКМ −1. Shift+клик по броску: +8 перед броском.">
                    {{#each heroPoints.pips}}
                      {{#if filled}}
                        <img class="pf1-hero-point-pip is-filled" data-index="{{index}}" src="{{../heroPoints.icon}}" alt="">
                      {{else}}
                        <span class="pf1-hero-point-pip is-empty" data-index="{{index}}"></span>
                      {{/if}}
                    {{/each}}
                  </a>
                {{/if}}
              </div>
              <div class="pf1-party-statline">
                <section class="pf1-ac-group">
                  <div class="pf1-ac"><span>КБ</span><strong>{{ac}}</strong></div>
                  <div class="pf1-ac"><span>Касание</span><strong>{{combat.ac.touch}}</strong></div>
                  <div class="pf1-ac"><span>Врасплох</span><strong>{{combat.ac.flatFooted}}</strong></div>
                </section>
                <section class="pf1-saving-throws">
                  <button type="button" class="pf1-save is-rollable" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="fort" data-bonus="{{saves.fort}}" title="Бросить испытание Стойкости" {{#unless rollable}}disabled{{/unless}}><span>Стойкость</span><strong>{{signed saves.fort}}</strong></button>
                  <button type="button" class="pf1-save is-rollable" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="ref" data-bonus="{{saves.ref}}" title="Бросить испытание Реакции" {{#unless rollable}}disabled{{/unless}}><span>Реакция</span><strong>{{signed saves.ref}}</strong></button>
                  <button type="button" class="pf1-save is-rollable" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="will" data-bonus="{{saves.will}}" title="Бросить испытание Воли" {{#unless rollable}}disabled{{/unless}}><span>Воля</span><strong>{{signed saves.will}}</strong></button>
                </section>
                <div class="pf1-senses"><span>Чувства</span><strong>{{senses}}</strong></div>
              </div>
              <div class="pf1-member-combat-tags">
                <div class="pf1-combat-check" title="Базовый модификатор атаки"><span>БМА</span><strong>{{signed combat.bab}}</strong></div>
                <div class="pf1-combat-check" title="Защита от боевых манёвров"><span>ЗБМ</span><strong>{{combat.cmd}}</strong></div>
                <button type="button" class="pf1-combat-check is-rollable" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="cmb" data-bonus="{{combat.cmb}}" title="Бросить проверку боевого манёвра" {{#unless rollable}}disabled{{/unless}}><span>МБМ</span><strong>{{signed combat.cmb}}</strong></button>
                <button type="button" class="pf1-combat-check is-rollable" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="melee" data-bonus="{{combat.melee}}" title="Бросить атаку ближнего боя" {{#unless rollable}}disabled{{/unless}}><span>Ближний бой</span><strong>{{signed combat.melee}}</strong></button>
                <button type="button" class="pf1-combat-check is-rollable" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="ranged" data-bonus="{{combat.ranged}}" title="Бросить дистанционную атаку" {{#unless rollable}}disabled{{/unless}}><span>Дистанционный бой</span><strong>{{signed combat.ranged}}</strong></button>
              </div>
              <div class="pf1-member-skill-tags">
                <button type="button" class="pf1-perception" data-action="roll-skill" data-actor-id="{{id}}" data-skill-id="per" title="Shift+клик: геройское очко +8 перед броском" {{#unless rollable}}disabled{{/unless}}>Внимание {{signed perception}}</button>
                {{#each investedSkills}}
                  <button type="button" class="pf1-member-skill-tag" data-action="roll-skill" data-actor-id="{{../id}}" data-skill-id="{{id}}" title="Ранги: {{fmt ranks 0}}. Shift+клик: геройское очко +8 перед броском" {{#unless ../rollable}}disabled{{/unless}}>{{label}} {{signed bonus}}</button>
                {{/each}}
              </div>
            </div>
          </article>
        {{/each}}
      </div>
    </section>

    <section class="tab" data-group="primary" data-tab="statistics">
      <div class="pf1-party-statistics-layout">
        <aside class="pf1-party-side pf1-statistics-sidebar">
          <div class="pf1-side-table">
            <h3>Путешествие партии</h3>
            <div class="pf1-travel-speed-row"><span>Скорость<br>путешествия</span><b>{{travel.speed}} фт</b></div>
            <div><span>Футов в минуту</span><b>{{travel.feetPerMinute}}</b></div>
            <div><span>Миль в час</span><b>{{travel.milesPerHour}}</b></div>
            <div><span>Миль в день</span><b>{{travel.milesPerDay}}</b></div>
          </div>
          <button type="button" class="pf1-statistics-rest" data-action="long-rest" title="Долгий отдых"><i class="fas fa-bed"></i> Долгий отдых</button>
        </aside>

        <div class="pf1-statistics-content">
          <nav class="pf1-statistics-category-tabs" aria-label="Категории статистики">
            <button type="button" class="is-active" data-stat-tab="abilities" aria-selected="true">Характеристики</button>
            <button type="button" data-stat-tab="movement" aria-selected="false">Передвижение и размер</button>
            <button type="button" data-stat-tab="defense" aria-selected="false">Защита и проверки</button>
            <button type="button" data-stat-tab="special" aria-selected="false">Особые виды защиты и восстановление</button>
          </nav>

          <section class="pf1-party-statistics-main">
          {{#each statisticsMembers}}
            <article class="pf1-stat-card" data-actor-id="{{id}}">
              <header class="pf1-stat-card-header">
                <img src="{{img}}" alt="{{name}}">
                <strong>{{name}}</strong>
                {{#unless statistics.editable}}<span class="pf1-stat-readonly"><i class="fas fa-lock"></i> Только просмотр</span>{{/unless}}
              </header>

              <div class="pf1-stat-health" style="--pf1-hp-width: {{statistics.hp.width}}; --pf1-negative-hp-width: {{statistics.hp.negativeWidth}}; --pf1-temp-hp-width: {{statistics.hp.tempWidth}}; --pf1-nonlethal-width: {{statistics.hp.nonlethalWidth}};">
                <label class="pf1-hp-vessel pf1-hp-vessel-main {{#if statistics.hp.negative}}is-negative{{/if}}" title="Текущие и максимальные ПЗ">
                  <span class="pf1-hp-vessel-title">ПЗ</span>
                  <span class="pf1-hp-vessel-shape" aria-hidden="true"><span class="pf1-hp-vessel-fill"></span></span>
                  <span class="pf1-hp-vessel-values"><input class="pf1-stat-field" data-path="system.attributes.hp.value" data-type="number" value="{{statistics.hp.value}}" aria-label="Текущие ПЗ" {{#unless statistics.editable}}disabled{{/unless}}><b>/</b><input class="pf1-stat-field" data-path="system.attributes.hp.base" data-type="number" value="{{statistics.hp.max}}" aria-label="Максимальные ПЗ" {{#unless statistics.editable}}disabled{{/unless}}></span>
                </label>
                <label class="pf1-hp-vessel pf1-hp-vessel-temp" title="Временные ПЗ">
                  <span class="pf1-hp-vessel-title">Временные</span>
                  <span class="pf1-hp-vessel-shape" aria-hidden="true"><span class="pf1-hp-vessel-fill"></span></span>
                  <input class="pf1-stat-field" data-path="system.attributes.hp.temp" data-type="number" value="{{statistics.hp.temp}}" aria-label="Временные ПЗ" {{#unless statistics.editable}}disabled{{/unless}}>
                </label>
                <label class="pf1-hp-vessel pf1-hp-vessel-nonlethal" title="Нелетальный урон">
                  <span class="pf1-hp-vessel-title">Нелетальные</span>
                  <span class="pf1-hp-vessel-shape" aria-hidden="true"><span class="pf1-hp-vessel-fill"></span></span>
                  <input class="pf1-stat-field" data-path="system.attributes.hp.nonlethal" data-type="number" value="{{statistics.hp.nonlethal}}" aria-label="Нелетальный урон" {{#unless statistics.editable}}disabled{{/unless}}>
                </label>
              </div>

              <section class="pf1-stat-section pf1-stat-category is-active" data-stat-category="abilities">
                <h4>Характеристики</h4>
                <div class="pf1-stat-ability-cards">
                  {{#each statistics.abilities}}
                    <article class="pf1-stat-ability-card tooltip">
                      {{{tooltipHtml}}}
                      <button type="button" class="pf1-stat-roll-title" data-action="roll-ability" data-actor-id="{{../id}}" data-ability="{{id}}" data-bonus="{{mod}}" title="Бросить проверку характеристики {{label}}" {{#unless ../statistics.rollable}}disabled{{/unless}}><i class="fas fa-dice-d20"></i><span>{{label}}</span></button>
                      <div class="pf1-stat-ability-main">
                        <span class="pf1-stat-ability-mod" title="Модификатор"><small>Мод.</small><b>{{signed mod}}</b></span>
                        <strong class="pf1-stat-ability-total" title="Итоговое значение характеристики">{{total}}</strong>
                        <label class="pf1-stat-ability-base" title="Базовое значение"><small>База</small><input class="pf1-stat-field" data-path="{{valuePath}}" data-type="number" value="{{value}}" {{#unless ../statistics.editable}}disabled{{/unless}}></label>
                      </div>
                      <div class="pf1-stat-ability-effects">
                        <label><input class="pf1-stat-field" data-path="{{damagePath}}" data-type="number" value="{{damage}}" {{#unless ../statistics.editable}}disabled{{/unless}}><small>УРН</small></label>
                        <label><input class="pf1-stat-field" data-path="{{drainPath}}" data-type="number" value="{{drain}}" {{#unless ../statistics.editable}}disabled{{/unless}}><small>ШТР</small></label>
                        <label><input class="pf1-stat-field" data-path="{{penaltyPath}}" data-type="number" value="{{penalty}}" {{#unless ../statistics.editable}}disabled{{/unless}}><small>ПТР</small></label>
                      </div>
                    </article>
                  {{/each}}
                </div>
              </section>

              <section class="pf1-stat-section pf1-stat-category" data-stat-category="movement" hidden>
                  <h4>Передвижение и размер</h4>
                  <div class="pf1-stat-speed-grid">
                    {{#each statistics.speeds}}
                      <label class="pf1-stat-speed-card tooltip">{{{tooltipHtml}}}<span><i class="fas {{icon}}"></i>{{label}}</span><input class="pf1-stat-field" data-path="{{path}}" data-type="number" value="{{base}}" {{#unless ../statistics.editable}}disabled{{/unless}}><em>итог {{total}} фт</em></label>
                    {{/each}}
                  </div>
                  <div class="pf1-stat-movement-details">
                    <label class="pf1-stat-maneuver-detail"><span><i class="fas fa-feather-alt"></i>Манёвренность полёта</span><i class="pf1-stat-detail-spacer" aria-hidden="true"></i><select class="pf1-stat-field" data-path="system.attributes.speed.fly.maneuverability" data-type="string" {{#unless statistics.editable}}disabled{{/unless}}>{{#each statistics.flyManeuverabilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                    <label class="pf1-stat-size-detail"><span><i class="fas fa-expand-arrows-alt"></i>Размер</span><em>мод. {{statistics.sizeModifier}}</em><select class="pf1-stat-field" data-path="system.traits.size" data-type="string" {{#unless statistics.editable}}disabled{{/unless}}>{{#each statistics.sizeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  </div>
              </section>

              <section class="pf1-stat-section pf1-stat-category" data-stat-category="defense" hidden>
                  <h4>Защита и проверки</h4>
                  <div class="pf1-stat-defense-top">
                    <section class="pf1-ac-group pf1-stat-ac-shields">
                      <div class="pf1-ac tooltip">{{{statistics.ac.normalTooltipHtml}}}<span>КБ</span><strong>{{statistics.ac.normal}}</strong></div>
                      <div class="pf1-ac tooltip">{{{statistics.ac.touchTooltipHtml}}}<span>Касание</span><strong>{{statistics.ac.touch}}</strong></div>
                      <div class="pf1-ac tooltip">{{{statistics.ac.flatFootedTooltipHtml}}}<span>Врасплох</span><strong>{{statistics.ac.flatFooted}}</strong></div>
                    </section>
                    <div class="pf1-stat-save-cards">
                      <article class="pf1-stat-save-card">
                      <button type="button" class="tooltip" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="fort" data-bonus="{{statistics.saves.fort.total}}" {{#unless statistics.rollable}}disabled{{/unless}}>{{{statistics.saves.fort.tooltipHtml}}}<span><i class="fas fa-shield-alt"></i> Стойкость</span><b>{{signed statistics.saves.fort.total}}</b></button>
                        <label><span>Бонус</span><input class="pf1-stat-field" data-path="system.attributes.savingThrows.fort.base" data-type="number" value="{{statistics.saves.fort.base}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                      </article>
                      <article class="pf1-stat-save-card">
                      <button type="button" class="tooltip" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="ref" data-bonus="{{statistics.saves.ref.total}}" {{#unless statistics.rollable}}disabled{{/unless}}>{{{statistics.saves.ref.tooltipHtml}}}<span><i class="fas fa-running"></i> Реакция</span><b>{{signed statistics.saves.ref.total}}</b></button>
                        <label><span>Бонус</span><input class="pf1-stat-field" data-path="system.attributes.savingThrows.ref.base" data-type="number" value="{{statistics.saves.ref.base}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                      </article>
                      <article class="pf1-stat-save-card">
                      <button type="button" class="tooltip" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="will" data-bonus="{{statistics.saves.will.total}}" {{#unless statistics.rollable}}disabled{{/unless}}>{{{statistics.saves.will.tooltipHtml}}}<span><i class="fas fa-brain"></i> Воля</span><b>{{signed statistics.saves.will.total}}</b></button>
                        <label><span>Бонус</span><input class="pf1-stat-field" data-path="system.attributes.savingThrows.will.base" data-type="number" value="{{statistics.saves.will.base}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                      </article>
                    </div>
                  </div>
                  <div class="pf1-stat-form-grid pf1-stat-defense-fields">
                    <article class="pf1-stat-initiative-card">
                      <button type="button" class="pf1-stat-summary-roll tooltip" data-action="roll-initiative" data-actor-id="{{id}}" data-bonus="{{statistics.initiative.total}}" {{#unless statistics.rollable}}disabled{{/unless}}>{{{statistics.initiative.tooltipHtml}}}<small><i class="fas fa-bolt"></i> Инициатива</small><b>{{signed statistics.initiative.total}}</b></button>
                      <label><span>Бонус Инициативы</span><input class="pf1-stat-field" data-path="system.attributes.init.value" data-type="number" value="{{statistics.initiative.value}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                    </article>
                    <label><span>Естественная броня</span><input class="pf1-stat-field" data-path="system.attributes.naturalAC" data-type="number" value="{{statistics.naturalAC}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                    <label class="pf1-stat-sr-field"><span>УкМ <em>итог {{statistics.spellResistanceTotal}}</em></span><input class="pf1-stat-field" data-path="system.attributes.sr.formula" data-type="string" value="{{statistics.spellResistanceFormula}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                    <label><span>Уровень потери</span><input class="pf1-stat-field" data-path="system.attributes.energyDrain" data-type="number" value="{{statistics.energyDrain}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                    <span class="pf1-stat-defense-output"><small>Макс. Лвк</small><b>{{statistics.maxDexBonus}}</b></span>
                    <span class="pf1-stat-defense-output"><small>Штраф брони</small><b>{{statistics.armorCheckPenalty}}</b></span>
                  </div>
                  <div class="pf1-stat-combat-checks">
                    <span class="tooltip">{{{statistics.combat.babTooltipHtml}}}<small>БМА</small><b>{{signed statistics.combat.bab}}</b></span>
                    <span class="tooltip">{{{statistics.combat.cmdTooltipHtml}}}<small>ЗБМ</small><b>{{statistics.combat.cmd}}</b></span>
                    <button type="button" class="tooltip" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="cmb" data-bonus="{{statistics.combat.cmb}}" {{#unless statistics.rollable}}disabled{{/unless}}>{{{statistics.combat.cmbTooltipHtml}}}<small>МБМ</small><b>{{signed statistics.combat.cmb}}</b></button>
                    <button type="button" class="tooltip" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="melee" data-bonus="{{statistics.combat.melee}}" {{#unless statistics.rollable}}disabled{{/unless}}>{{{statistics.combat.meleeTooltipHtml}}}<small>Ближний бой</small><b>{{signed statistics.combat.melee}}</b></button>
                    <button type="button" class="tooltip" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="ranged" data-bonus="{{statistics.combat.ranged}}" {{#unless statistics.rollable}}disabled{{/unless}}>{{{statistics.combat.rangedTooltipHtml}}}<small>Дистанционный бой</small><b>{{signed statistics.combat.ranged}}</b></button>
                  </div>
              </section>

              <section class="pf1-stat-section pf1-stat-category" data-stat-category="special" hidden>
                <h4>Особые виды защиты и восстановление</h4>
                <div class="pf1-stat-recovery-cards">
                  <label><span><i class="fas fa-heartbeat"></i> Быстрое лечение</span><input class="pf1-stat-field" data-path="system.traits.fastHealing" data-type="string" data-empty-zero="true" value="{{statistics.fastHealing}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                  <label><span><i class="fas fa-sync-alt"></i> Регенерация</span><input class="pf1-stat-field" data-path="system.traits.regen" data-type="string" data-empty-zero="true" value="{{statistics.regeneration}}" {{#unless statistics.editable}}disabled{{/unless}}></label>
                </div>
                <section class="pf1-stat-social-defense">
                  <h5><i class="fas fa-user-shield"></i> Социальная защита</h5>
                  <div>
                    <span class="tooltip">{{{statistics.socialDefense.demoralize.tooltipHtml}}}<small><i class="fas fa-comment-slash"></i> Сложность Деморализации</small><b>{{statistics.socialDefense.demoralize.total}}</b></span>
                    <span class="tooltip">{{{statistics.socialDefense.feint.tooltipHtml}}}<small><i class="fas fa-theater-masks"></i> Сложность Финта</small><b>{{statistics.socialDefense.feint.total}}</b></span>
                  </div>
                </section>
                <div class="pf1-stat-trait-groups">
                  {{#each statistics.traitGroups}}
                    <section class="pf1-stat-trait-group" data-trait-group="{{id}}">
                      <h5>{{label}}</h5>
                      <div class="pf1-stat-traits">
                        {{#each traits}}
                          <label title="Сейчас: {{value}}"><span>{{label}}</span><output>{{value}}</output><button type="button" class="pf1-stat-native-editor" data-action="open-actor-traits" data-actor-id="{{../../id}}" data-trait-id="{{id}}" title="Настроить {{label}}" {{#unless ../../statistics.editable}}disabled{{/unless}}><i class="fas fa-cog"></i></button></label>
                        {{/each}}
                      </div>
                    </section>
                  {{/each}}
                </div>
              </section>
            </article>
          {{else}}
            <div class="pf1-empty">Нет доступных персонажей из папки партии.</div>
          {{/each}}
          </section>
        </div>
      </div>
    </section>

    <section class="tab" data-group="primary" data-tab="stash">
      <div class="pf1-party-stash-layout">
        <aside class="pf1-party-side">
          <div class="pf1-side-table">
            <h3>Всего в партии</h3>
            <div><span><i class="fas fa-coins"></i> Валюта</span><b>{{partyTotals.coinGp}} зм</b></div>
            <div><span><i class="fas fa-balance-scale"></i> Богатство</span><b>{{partyTotals.wealthGp}} зм</b></div>
            <div><span>Вес</span><b>{{partyTotals.weight}} фнт.</b></div>
          </div>
          {{#each members}}
            <article class="pf1-small-member-card pf1-inventory-member-card">
              <div class="pf1-small-member-content">
                <img src="{{img}}" alt="{{name}}">
                <div class="pf1-small-member-info">
                  <strong>{{name}}</strong>
                  <span><i class="fas fa-coins"></i> {{wealth.coinGp}} зм</span>
                  <span><i class="fas fa-balance-scale"></i> {{wealth.wealthGp}} зм</span>
                </div>
              </div>
              <footer class="pf1-small-member-weight">Вес — {{wealth.weight}} фнт.</footer>
            </article>
          {{/each}}
        </aside>

        <section class="pf1-party-stash-main pf1-party-dropzone">
          <div class="pf1-currency-bar">
            <span>Валюта</span>
            {{#each stash.currencyArray}}
              <label class="pf1-coin" title="Можно ввести число, +10 или -10"><img src="{{img}}" alt="{{label}}"><input type="text" class="pf1-currency-input" data-coin="{{key}}" value="{{value}}"></label>
            {{/each}}
            <button type="button" data-action="add-currency" title="Добавить валюту"><span aria-hidden="true">+</span></button>
            <button type="button" data-action="subtract-currency" title="Вычесть валюту"><span aria-hidden="true">−</span></button>
            <button type="button" data-action="split-currency" title="Распределить монеты между участниками"><i class="fas fa-share fa-fw"></i></button>
          </div>
          <div class="pf1-stash-total-line">
            <b><i class="fas fa-coins"></i> Общая валюта</b> {{stashTotals.coinGp}} зм
            <b><i class="fas fa-balance-scale"></i> Общее богатство</b> {{stashTotals.wealthGp}} зм
          </div>
          <div class="pf1-search-line"><i class="fas fa-search"></i><input type="search" class="pf1-stash-search" placeholder="Искать в инвентаре">{{#if party.canIdentifyItems}}<button type="button" class="pf1-stash-identification-open" data-action="open-stash-identification"><i class="fas fa-eye"></i> Опознание предметов</button>{{/if}}</div>

          <div class="pf1-stash-inventory-list">
            {{#each stash.categories}}
              <details class="pf1-stash-category" open>
                <summary>
                  <h3 class="pf1-stash-category-name">{{label}}</h3>
                  <span class="pf1-stash-heading-price">Цена</span>
                  <span class="pf1-stash-heading-quantity">Количество</span>
                  <span class="pf1-stash-heading-weight">Вес</span>
                  <div class="pf1-stash-category-controls">
                    <button type="button" data-action="stash-category-add" data-category="{{id}}" title="Создать предмет"><i class="fas fa-plus"></i></button>
                    <button type="button" data-action="open-item-library" data-category="{{id}}" title="Открыть библиотеки Pathfinder 1e"><i class="fas fa-search"></i></button>
                  </div>
                </summary>
                <div class="pf1-stash-item-list {{#unless items.length}}is-empty{{/unless}}">
                  {{#each items}}
                    <div class="pf1-stash-item pf1-party-item {{#if emptyStack}}is-empty-stack{{/if}} {{#if isContainer}}is-container{{/if}} {{#if containerOpen}}is-container-open{{/if}}" data-item-id="{{stashId}}" data-search="{{search}}" draggable="true">
                      <div class="pf1-stash-item-name">
                        {{#if isContainer}}<button type="button" class="pf1-stash-container-toggle" data-action="toggle-stash-container" data-item-id="{{stashId}}" aria-expanded="{{containerOpen}}" title="Показать содержимое"><i class="fas {{#if containerOpen}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></button>{{/if}}
                        <img src="{{img}}" alt="{{name}}">
                        <span>{{name}}</span>
                      </div>
                      <label class="pf1-stash-price" title="Наведи или нажми, чтобы изменить цену за штуку"><input type="text" class="pf1-stash-field" data-field="price" data-item-id="{{stashId}}" data-price-each="{{priceEach}}" data-price-total="{{priceGp}}" value="{{priceGp}}"><span>зм</span></label>
                      <span class="pf1-stash-quantity" data-item-id="{{stashId}}" title="Кнопки меняют количество">
                        <button type="button" data-action="change-stash-quantity" data-delta="-1" data-item-id="{{stashId}}" title="Убавить количество">−</button>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" class="pf1-stash-field pf1-stash-quantity-input" data-field="quantity" data-item-id="{{stashId}}" value="{{quantity}}">
                        <button type="button" data-action="change-stash-quantity" data-delta="1" data-item-id="{{stashId}}" title="Добавить количество">+</button>
                      </span>
                      <label class="pf1-stash-weight" title="Изменить вес"><input type="text" class="pf1-stash-field" data-field="weight" data-item-id="{{stashId}}" value="{{weight}}"><span>фнт.</span></label>
                      <div class="pf1-stash-item-controls">
                        {{#if @root.party.canToggleIdentification}}<button type="button" data-action="toggle-stash-identification" data-item-id="{{stashId}}" title="{{identifyTitle}}"><i class="fas {{identifyIcon}}"></i></button>{{/if}}
                        <button type="button" data-action="edit-stash-item" data-item-id="{{stashId}}" title="Редактировать"><i class="fas fa-edit"></i></button>
                        <button type="button" data-action="split-stash-item" data-item-id="{{stashId}}" title="Разделить стопку"><i class="fas fa-divide"></i></button>
                        <button type="button" data-action="take-item" data-item-id="{{stashId}}" title="Забрать в лист"><i class="fas fa-hand-paper"></i></button>
                        <button type="button" data-action="delete-stash-item" data-item-id="{{stashId}}" title="Удалить"><i class="fas fa-trash"></i></button>
                      </div>
                      <div class="pf1-stash-item-description">{{{description}}}</div>
                      {{#if isContainer}}
                        <div class="pf1-stash-container-contents" data-container-stash-id="{{stashId}}">
                          {{#each containerItems}}
                            <div class="pf1-stash-container-item" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" data-search="{{search}}" draggable="true">
                              <div class="pf1-stash-container-item-name"><img src="{{img}}" alt="{{name}}"><span>{{name}}</span></div>
                              <label class="pf1-stash-price pf1-stash-container-item-price" title="Наведи или нажми, чтобы изменить цену за штуку"><input type="text" class="pf1-stash-container-field" data-field="price" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" data-price-each="{{priceEach}}" data-price-total="{{priceGp}}" value="{{priceGp}}"><span>зм</span></label>
                              <span class="pf1-stash-quantity pf1-stash-container-item-quantity" title="Кнопки меняют количество">
                                <button type="button" data-action="change-stash-container-quantity" data-delta="-1" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" title="Убавить количество">−</button>
                                <input type="text" inputmode="numeric" pattern="[0-9]*" class="pf1-stash-container-field pf1-stash-quantity-input" data-field="quantity" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" value="{{quantity}}">
                                <button type="button" data-action="change-stash-container-quantity" data-delta="1" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" title="Добавить количество">+</button>
                              </span>
                              <label class="pf1-stash-weight pf1-stash-container-item-weight" title="Изменить вес"><input type="text" class="pf1-stash-container-field" data-field="weight" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" value="{{weight}}"><span>фнт.</span></label>
                              {{#if @root.party.canToggleIdentification}}<button type="button" class="pf1-stash-container-identify" data-action="toggle-stash-identification" data-item-id="{{../stashId}}" data-container-item-id="{{itemId}}" title="{{identifyTitle}}"><i class="fas {{identifyIcon}}"></i></button>{{/if}}
                            </div>
                          {{else}}
                            <div class="pf1-stash-container-empty">Пусто</div>
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              </details>
            {{/each}}
          </div>
          <div class="pf1-stash-footer"><img class="pf1-stash-footer-icon" src="modules/pf1e-party-folder/assets/pack-leather-white-tan.webp" alt=""> ОБЩИЙ ВЕС: {{stashTotals.weight}} фнт.</div>
        </section>
      </div>
    </section>
  </main>
</form>
