<form class="pf1-party-sheet-root {{party.portraitClass}} {{party.themeClass}}" autocomplete="off">
  <header class="pf1-party-hero">
    <div class="pf1-party-token-wrap">
      <div class="pf1-party-token-drag" draggable="true" title="Перетащить токен партии на сцену">
        <img src="{{party.tokenImg}}" alt="The Party" draggable="false">
      </div>
      <button type="button" class="pf1-party-img-edit" data-action="edit-party-img" title="Сменить картинку партии"><i class="fas fa-image"></i></button>
    </div>
    <div class="pf1-party-title-block">
      <input type="text" class="pf1-party-name-input" value="{{party.name}}" title="Переименовать партию">
    </div>
    <div class="pf1-party-right-title">
      <div>ПАРТИЯ</div>
      <span class="pf1-metagame-open" data-action="metagame-settings" title="Метаигровая информация"><i class="fas fa-cog"></i> {{party.permissionLabel}}</span>
      <small class="pf1-party-version">{{party.moduleVersion}}</small>
    </div>
  </header>

  <nav class="pf1-party-primary-tabs tabs" data-group="primary">
    <a class="item active" data-tab="overview">Обзор</a>
    <a class="item" data-tab="exploration">Исследование</a>
    <a class="item" data-tab="stash">Тайник</a>
  </nav>

  <main class="pf1-party-body">
    <section class="tab active" data-group="primary" data-tab="overview">
      <div class="pf1-party-panel pf1-party-overview-box">
        <nav class="pf1-party-overview-tabs tabs" data-group="overview">
          <a class="item active" data-tab="languages">Языки партии</a>
          <a class="item" data-tab="skills">Навыки партии</a>
          <a class="item" data-tab="knowledge">Вспомнить информацию</a>
        </nav>

        <section class="pf1-overview-content">
          <div class="tab active" data-group="overview" data-tab="languages">
            {{#if languages.length}}
              <div class="pf1-chip-list">
                {{#each languages}}
                  <span class="pf1-chip">{{this}}</span>
                {{/each}}
              </div>
            {{else}}
              <div class="pf1-empty">Нет</div>
            {{/if}}
          </div>

          <div class="tab" data-group="overview" data-tab="skills">
            {{#if skillGroups.length}}
              <div class="pf1-skill-groups">
                {{#each skillGroups}}
                  <section class="pf1-skill-group pf1-skill-group-{{id}}">
                    <h4>{{label}}</h4>
                    <div class="pf1-chip-list pf1-skill-list">
                      {{#each items}}
                        <button type="button" class="pf1-chip pf1-skill-chip {{toneClass}} {{#if invested}}is-invested{{/if}}" data-action="roll-skill" data-skill-id="{{id}}" data-skill-label="{{label}}" data-tooltip="{{tooltipHtml}}">
                          <span class="pf1-skill-main"><span class="pf1-skill-label">{{label}}</span><strong class="pf1-skill-bonus">{{signed best}}</strong></span>
                          <span class="pf1-skill-best">Лучший: {{bestActorName}}</span>
                        </button>
                      {{/each}}
                    </div>
                  </section>
                {{/each}}
              </div>
            {{else}}
              <div class="pf1-empty">Нет доступных навыков</div>
            {{/if}}
          </div>

          <div class="tab" data-group="overview" data-tab="knowledge">
            {{#if knowledgeGroups.length}}
              <div class="pf1-skill-groups">
                {{#each knowledgeGroups}}
                  <section class="pf1-skill-group pf1-skill-group-{{id}}">
                    <h4>{{label}}</h4>
                    <div class="pf1-chip-list pf1-skill-list">
                      {{#each items}}
                        <button type="button" class="pf1-chip pf1-skill-chip {{toneClass}} {{#if invested}}is-invested{{/if}}" data-action="roll-skill" data-skill-id="{{id}}" data-skill-label="{{label}}" data-tooltip="{{tooltipHtml}}">
                          <span class="pf1-skill-main"><span class="pf1-skill-label">{{label}}</span><strong class="pf1-skill-bonus">{{signed best}}</strong></span>
                          <span class="pf1-skill-best">Лучший: {{bestActorName}}</span>
                        </button>
                      {{/each}}
                    </div>
                  </section>
                {{/each}}
              </div>
            {{else}}
              <div class="pf1-empty">У партии нет навыков знаний</div>
            {{/if}}
          </div>
        </section>
      </div>

      <div class="pf1-party-member-list">
        {{#each members}}
          <article class="pf1-party-member-row">
            <div class="pf1-party-member-portrait">
              <img src="{{img}}" alt="{{name}}">
              <div class="pf1-party-hp" style="--pf1-hp-width: {{hp.width}};"><i class="fas fa-heart"></i> {{hp.value}} / {{hp.max}}</div>
            </div>
            <div class="pf1-party-member-main">
              <div class="pf1-party-member-header">
                <div class="pf1-party-member-name">{{name}} <span class="pf1-remove-member" data-action="remove-member" data-actor-id="{{id}}" title="Убрать из партии">×</span></div>
                {{#if heroPoints.enabled}}
                  <a class="pf1-hero-points" data-action="adjust-hero-points" data-actor-id="{{id}}" title="Геройские очки: {{heroPoints.value}} / {{heroPoints.max}}. ЛКМ +1, ПКМ −1. Shift+клик по броску: +8 перед броском.">
                    {{#each heroPoints.pips}}
                      {{#if filled}}
                        <img class="pf1-hero-point-pip is-filled" data-index="{{index}}" src="{{../heroPoints.icon}}" alt="">
                      {{else}}
                        <span class="pf1-hero-point-pip is-empty" data-index="{{index}}"></span>
                      {{/if}}
                    {{/each}}
                  </a>
                {{/if}}
              </div>
              <div class="pf1-party-statline">
                <section class="pf1-ac-group">
                  <div class="pf1-ac"><span>КБ</span><strong>{{ac}}</strong></div>
                  <div class="pf1-ac"><span>Касание</span><strong>{{combat.ac.touch}}</strong></div>
                  <div class="pf1-ac"><span>Врасплох</span><strong>{{combat.ac.flatFooted}}</strong></div>
                </section>
                <section class="pf1-saving-throws">
                  <button type="button" class="pf1-save is-rollable" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="fort" data-bonus="{{saves.fort}}" title="Бросить испытание Стойкости"><span>Стойкость</span><strong>{{signed saves.fort}}</strong></button>
                  <button type="button" class="pf1-save is-rollable" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="ref" data-bonus="{{saves.ref}}" title="Бросить испытание Реакции"><span>Реакция</span><strong>{{signed saves.ref}}</strong></button>
                  <button type="button" class="pf1-save is-rollable" data-action="roll-saving-throw" data-actor-id="{{id}}" data-save="will" data-bonus="{{saves.will}}" title="Бросить испытание Воли"><span>Воля</span><strong>{{signed saves.will}}</strong></button>
                </section>
                <div class="pf1-senses"><span>Чувства</span><strong>{{senses}}</strong></div>
              </div>
              <div class="pf1-member-combat-tags">
                <div class="pf1-combat-check" title="Базовый модификатор атаки"><span>БМА</span><strong>{{signed combat.bab}}</strong></div>
                <div class="pf1-combat-check" title="Защита от боевых манёвров"><span>ЗБМ</span><strong>{{combat.cmd}}</strong></div>
                <button type="button" class="pf1-combat-check is-rollable" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="cmb" data-bonus="{{combat.cmb}}" title="Бросить проверку боевого манёвра"><span>МБМ</span><strong>{{signed combat.cmb}}</strong></button>
                <button type="button" class="pf1-combat-check is-rollable" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="melee" data-bonus="{{combat.melee}}" title="Бросить атаку ближнего боя"><span>Ближний бой</span><strong>{{signed combat.melee}}</strong></button>
                <button type="button" class="pf1-combat-check is-rollable" data-action="roll-combat-check" data-actor-id="{{id}}" data-check="ranged" data-bonus="{{combat.ranged}}" title="Бросить дистанционную атаку"><span>Дистанционный бой</span><strong>{{signed combat.ranged}}</strong></button>
              </div>
              <div class="pf1-member-skill-tags">
                <button type="button" class="pf1-perception" data-action="roll-skill" data-actor-id="{{id}}" data-skill-id="per" title="Shift+клик: геройское очко +8 перед броском">Внимание {{signed perception}}</button>
                {{#each investedSkills}}
                  <button type="button" class="pf1-member-skill-tag" data-action="roll-skill" data-actor-id="{{../id}}" data-skill-id="{{id}}" title="Ранги: {{fmt ranks 0}}. Shift+клик: геройское очко +8 перед броском">{{label}} {{signed bonus}}</button>
                {{/each}}
              </div>
            </div>
          </article>
        {{/each}}
      </div>
    </section>

    <section class="tab" data-group="primary" data-tab="exploration">
      <div class="pf1-party-exploration-layout">
        <aside class="pf1-party-side pf1e2-exploration-sidebar sidebar">
          <div class="pf1-side-table">
            <h3>Путешествие партии</h3>
            <div><span>Скорость путешествия</span><b>{{travel.speed}} фт</b></div>
            <div><span>Футов в минуту</span><b>{{travel.feetPerMinute}}</b></div>
            <div><span>Миль в час</span><b>{{travel.milesPerHour}}</b></div>
            <div><span>Миль в день</span><b>{{travel.milesPerDay}}</b></div>
            <div><span>Активностей исследования</span><b>{{travel.activitySlots}}</b></div>
          </div>

          <ol class="box-list exploration-members">
          {{#each members}}
            <li class="box member pf1-small-member-card">
              <div class="actor-link content">
                <img src="{{img}}" alt="{{name}}">
                <span class="name">{{name}}</span>
              </div>
              <div class="sub-data">
                <span class="pf1-small-member-speed"><i class="fas fa-shoe-prints"></i> {{speed}} фт</span>
                <span class="pf1-small-member-perception"><i class="fas fa-eye"></i> {{perception}}</span>
              </div>
              <footer class="health-bar pf1-small-member-hp" style="--pf1-hp-width: {{hp.width}};">
                <div class="bar pf1-small-member-hp-fill" style="width: {{hp.width}};"></div>
                <span class="pf1-small-member-hp-content"><i class="fas fa-heart"></i> <span class="pf1-small-member-hp-value">{{hp.value}} / {{hp.max}}</span></span>
              </footer>
            </li>
          {{/each}}
          </ol>
        </aside>

        <section class="pf1-party-exploration-main">
          <div class="pf1-party-action-bar">
            <button type="button" data-action="clear-activities">Очистить</button>
            <span></span>
            <button type="button" data-action="roll-activities" title="Создать проверку"><i class="fas fa-dice-d20"></i></button>
            <button type="button" data-action="long-rest" title="Долгий отдых"><i class="fas fa-bed"></i></button>
          </div>

          {{#each members}}
            <article class="pf1-activity-row">
              <img src="{{img}}" alt="{{name}}">
              <button type="button" class="pf1-activity-add" data-action="set-activity" data-actor-id="{{id}}">+</button>
              <div class="pf1-activity-text">
                <strong>{{activity.title}}</strong>
                <span>{{activity.subtitle}}</span>
              </div>
              {{#if activity.skillId}}
                <button type="button" class="pf1-activity-roll" data-action="roll-activity" data-actor-id="{{id}}"><i class="fas fa-dice-d20"></i></button>
              {{/if}}
            </article>
          {{/each}}
        </section>
      </div>
    </section>

    <section class="tab" data-group="primary" data-tab="stash">
      <div class="pf1-party-stash-layout">
        <aside class="pf1-party-side">
          <div class="pf1-side-table">
            <h3>Всего в партии</h3>
            <div><span><i class="fas fa-coins"></i> Валюта</span><b>{{partyTotals.coinGp}} зм</b></div>
            <div><span><i class="fas fa-balance-scale"></i> Богатство</span><b>{{partyTotals.wealthGp}} зм</b></div>
            <div><span>Вес</span><b>{{partyTotals.weight}} фнт.</b></div>
          </div>
          {{#each members}}
            <article class="pf1-small-member-card pf1-inventory-member-card">
              <div class="pf1-small-member-content">
                <img src="{{img}}" alt="{{name}}">
                <div class="pf1-small-member-info">
                  <strong>{{name}}</strong>
                  <span><i class="fas fa-coins"></i> {{wealth.coinGp}} зм</span>
                  <span><i class="fas fa-balance-scale"></i> {{wealth.wealthGp}} зм</span>
                </div>
              </div>
              <footer class="pf1-small-member-weight">Вес — {{wealth.weight}} фнт.</footer>
            </article>
          {{/each}}
        </aside>

        <section class="pf1-party-stash-main pf1-party-dropzone">
          <div class="pf1-currency-bar">
            <span>Валюта</span>
            {{#each stash.currencyArray}}
              <label class="pf1-coin" title="Можно ввести число, +10 или -10"><img src="{{img}}" alt="{{label}}"><input type="text" class="pf1-currency-input" data-coin="{{key}}" value="{{value}}"></label>
            {{/each}}
            <button type="button" data-action="add-currency" title="Добавить валюту"><span aria-hidden="true">+</span></button>
            <button type="button" data-action="subtract-currency" title="Вычесть валюту"><span aria-hidden="true">−</span></button>
            <button type="button" data-action="split-currency" title="Распределить монеты между участниками"><i class="fas fa-share fa-fw"></i></button>
          </div>
          <div class="pf1-stash-total-line">
            <b><i class="fas fa-coins"></i> Общая валюта</b> {{stashTotals.coinGp}} зм
            <b><i class="fas fa-balance-scale"></i> Общее богатство</b> {{stashTotals.wealthGp}} зм
          </div>
          <div class="pf1-search-line"><i class="fas fa-search"></i><input type="search" class="pf1-stash-search" placeholder="Искать в инвентаре"></div>

          <div class="pf1-stash-inventory-list">
            {{#each stash.categories}}
              <details class="pf1-stash-category" open>
                <summary>
                  <h3 class="pf1-stash-category-name">{{label}}</h3>
                  <span class="pf1-stash-heading-price">Цена</span>
                  <span class="pf1-stash-heading-quantity">Количество</span>
                  <span class="pf1-stash-heading-weight">Вес</span>
                  <div class="pf1-stash-category-controls">
                    <button type="button" data-action="stash-category-add" data-category="{{id}}" title="Создать предмет"><i class="fas fa-plus"></i></button>
                    <button type="button" data-action="open-item-library" data-category="{{id}}" title="Открыть библиотеки Pathfinder 1e"><i class="fas fa-search"></i></button>
                  </div>
                </summary>
                <div class="pf1-stash-item-list {{#unless items.length}}is-empty{{/unless}}">
                  {{#each items}}
                    <div class="pf1-stash-item pf1-party-item {{#if emptyStack}}is-empty-stack{{/if}} {{#if isContainer}}is-container{{/if}} {{#if containerOpen}}is-container-open{{/if}}" data-item-id="{{stashId}}" data-search="{{search}}" draggable="true">
                      <div class="pf1-stash-item-name">
                        {{#if isContainer}}<button type="button" class="pf1-stash-container-toggle" data-action="toggle-stash-container" data-item-id="{{stashId}}" aria-expanded="{{containerOpen}}" title="Показать содержимое"><i class="fas {{#if containerOpen}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></button>{{/if}}
                        <img src="{{img}}" alt="{{name}}">
                        <span>{{name}}</span>
                      </div>
                      <label class="pf1-stash-price" title="Наведи или нажми, чтобы изменить цену за штуку"><input type="text" class="pf1-stash-field" data-field="price" data-item-id="{{stashId}}" data-price-each="{{priceEach}}" data-price-total="{{priceGp}}" value="{{priceGp}}"><span>зм</span></label>
                      <span class="pf1-stash-quantity" data-item-id="{{stashId}}" title="Кнопки меняют количество">
                        <button type="button" data-action="change-stash-quantity" data-delta="-1" data-item-id="{{stashId}}" title="Убавить количество">−</button>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" class="pf1-stash-field pf1-stash-quantity-input" data-field="quantity" data-item-id="{{stashId}}" value="{{quantity}}">
                        <button type="button" data-action="change-stash-quantity" data-delta="1" data-item-id="{{stashId}}" title="Добавить количество">+</button>
                      </span>
                      <label class="pf1-stash-weight" title="Изменить вес"><input type="text" class="pf1-stash-field" data-field="weight" data-item-id="{{stashId}}" value="{{weight}}"><span>фнт.</span></label>
                      <div class="pf1-stash-item-controls">
                        <button type="button" data-action="edit-stash-item" data-item-id="{{stashId}}" title="Редактировать"><i class="fas fa-edit"></i></button>
                        <button type="button" data-action="split-stash-item" data-item-id="{{stashId}}" title="Разделить стопку"><i class="fas fa-divide"></i></button>
                        <button type="button" data-action="take-item" data-item-id="{{stashId}}" title="Забрать в лист"><i class="fas fa-hand-paper"></i></button>
                        <button type="button" data-action="delete-stash-item" data-item-id="{{stashId}}" title="Удалить"><i class="fas fa-trash"></i></button>
                      </div>
                      <div class="pf1-stash-item-description">{{{description}}}</div>
                      {{#if isContainer}}
                        <div class="pf1-stash-container-contents" data-container-stash-id="{{stashId}}">
                          {{#each containerItems}}
                            <div class="pf1-stash-container-item" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" data-search="{{search}}" draggable="true">
                              <div class="pf1-stash-container-item-name"><img src="{{img}}" alt="{{name}}"><span>{{name}}</span></div>
                              <label class="pf1-stash-price pf1-stash-container-item-price" title="Наведи или нажми, чтобы изменить цену за штуку"><input type="text" class="pf1-stash-container-field" data-field="price" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" data-price-each="{{priceEach}}" data-price-total="{{priceGp}}" value="{{priceGp}}"><span>зм</span></label>
                              <span class="pf1-stash-quantity pf1-stash-container-item-quantity" title="Кнопки меняют количество">
                                <button type="button" data-action="change-stash-container-quantity" data-delta="-1" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" title="Убавить количество">−</button>
                                <input type="text" inputmode="numeric" pattern="[0-9]*" class="pf1-stash-container-field pf1-stash-quantity-input" data-field="quantity" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" value="{{quantity}}">
                                <button type="button" data-action="change-stash-container-quantity" data-delta="1" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" title="Добавить количество">+</button>
                              </span>
                              <label class="pf1-stash-weight pf1-stash-container-item-weight" title="Изменить вес"><input type="text" class="pf1-stash-container-field" data-field="weight" data-container-stash-id="{{../stashId}}" data-item-id="{{itemId}}" value="{{weight}}"><span>фнт.</span></label>
                            </div>
                          {{else}}
                            <div class="pf1-stash-container-empty">Пусто</div>
                          {{/each}}
                        </div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
              </details>
            {{/each}}
          </div>
          <div class="pf1-stash-footer"><img class="pf1-stash-footer-icon" src="modules/pf1e-party-folder/assets/pack-leather-white-tan.webp" alt=""> ОБЩИЙ ВЕС: {{stashTotals.weight}} фнт.</div>
        </section>
      </div>
    </section>
  </main>
</form>
